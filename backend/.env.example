# development | production
ENVIRONMENT=development

# Comma-separated list of sites allowed to call the API from a browser.
ALLOWED_ORIGINS=http://localhost:3000,https://hasnainpirzada.vercel.app

# Resend (https://resend.com), the free tier is enough. Without these, messages are only logged in development.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Use onboarding@resend.dev until you verify your own domain in Resend.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# Max messages per sender per hour
RATE_LIMIT_PER_HOUR=5
