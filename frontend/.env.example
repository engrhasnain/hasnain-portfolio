# Public URL of the site (no trailing slash). Change when you move to a custom domain.
NEXT_PUBLIC_SITE_URL=https://hasnainpirzada.vercel.app

# Where the FastAPI backend runs. /api/* on the site is proxied here.
# Local: http://127.0.0.1:8000   Production: your backend URL, e.g. https://hasnainpirzada-api.vercel.app
API_URL=http://127.0.0.1:8000

# Google Search Console "HTML tag" verification code (only the content="..." value)
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools verification code (optional, if you don't import from Search Console)
BING_SITE_VERIFICATION=

# Umami Cloud website ID (free plan). Counts clicks on Fiverr, WhatsApp, LinkedIn, email and Contact.
# cloud.umami.is -> Add website -> copy the Website ID. Leave empty to turn tracking off.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
